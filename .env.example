# ResearchLens AI — environment variable template
# Copy this file to ".env" and fill in your real values.
#   PowerShell:  Copy-Item .env.example .env
# The .env file is git-ignored and must NEVER be committed.

# ---- LLM provider ----
# Which provider to use for answer generation: "gemini" (default) or "openai".
LLM_PROVIDER=gemini

# Google Gemini API key. Get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model name used for generation.
GEMINI_MODEL=gemini-1.5-flash

# ---- Optional: OpenAI (only needed if LLM_PROVIDER=openai) ----
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---- Embeddings ----
# Sentence-Transformers model used for BOTH documents and queries.
# Downloaded automatically on first run (~90 MB).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Retrieval / chunking defaults ----
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
